    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Up arrow, top left. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.55"
        android:pathData="M40,50V40H36L44,31L52,40H48V50Z" />
    <!-- Down arrow, bottom left. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.55"
        android:pathData="M40,58V68H36L44,77L52,68H48V58Z" />
    <!-- Right arrow, leaving. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M56,50H68V44L79,54L68,64V58H56Z" />
</vector>
